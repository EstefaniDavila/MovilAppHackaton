{
  "expo": {
    // ======================
    // CONFIGURACIÓN BÁSICA
    // ======================
    "name": "",
    "slug": "yachay-votu",
    "version": "1.0.0",
    "scheme": "yachayvotu",

    // ======================
    // APARIENCIA E INTERFAZ
    // ======================
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/logoyachay1.png",

    // ======================
    // ARQUITECTURA Y RENDIMIENTO
    // ======================
    "newArchEnabled": true,

    // ======================
    // CONFIGURACIÓN POR PLATAFORMA
    // ======================
    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.yachayvotu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoyachay1.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/logoyachay1.png"
    },

    // ======================
    // PLUGINS Y EXTENSIONES
    // ======================
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoyachay1.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],

    // ======================
    // EXPERIMENTOS Y CARACTERÍSTICAS AVANZADAS
    // ======================
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}